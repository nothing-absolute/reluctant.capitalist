---
import Base from './Base.astro';
import { SECTIONS } from '../consts';
import type { SectionKey } from '../consts';
import { pageUrl } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  section?: SectionKey;
  backLabel?: string;
}

const { title, description, section, backLabel } = Astro.props;
const sectionMeta = section ? SECTIONS.find((s) => s.key === section) : undefined;
---

<Base title={title} description={description ?? sectionMeta?.blurb}>
  <article class="container article">
    <div class="prose">
      <p class="back-link">
        <a href={pageUrl(section ? `/${section}/` : '/')}>&larr; {backLabel ?? (sectionMeta ? `All ${sectionMeta.title}` : 'Home')}</a>
      </p>
      <slot name="title">
        <h1>{title}</h1>
      </slot>
      <slot />
    </div>
  </article>
</Base>
