# build output
dist/
node_modules/
.astro/

# environment
.env
.env.local

# generated garden cache
.garden-cache/

# staging review tooling (local undo history + background job state)
.staging-backups/
.staging-jobs/

# raw vault copies — regenerate with `npm run snapshot`; keeps private notes out of the repo
snapshots/

# os / editor noise
.DS_Store
*.log
*.swp

# private source material (personal conversations, memoir drafts) — never commit
.private-imports/

# derived assets copied out of the Antigravity brain (145M of screenshots, media and
# scratch files). Originally ignored as "not source" — but ~59 posts reference 341 of
# these files, so a CI build without them 404s every image. Committed deliberately so a
# clean checkout builds a complete site. Regenerable with
# `node scripts/import-antigravity.mjs --prune`; redact before committing:
# `node scripts/redact-paths.mjs`.
# public/antigravity/

# review + audit working state (230M of reports, draft previews and quarantine copies).
# Regenerable by the scripts in scripts/; kept local so it stays out of the public repo.
reviews/

# video render scratch (local test artifacts)
video/.venv/
video/out/
video/assets/
video/__pycache__/
*TEMP_MPY*
*.pyc
