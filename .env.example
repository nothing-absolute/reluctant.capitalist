# Copy to .env and fill in. Never commit .env.

# --- LLM chat (OpenAI-compatible API) ---
# Leave OPENAI_API_KEY empty to run in "demo mode": the chat answers with a
# canned reply explaining it is not configured.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Comma-separated models exposed in the chat model picker (optional).
# Example: "gpt-4o-mini,local://ollama/qwen2.5:7b"
# A "local://" entry points at OPENAI_LOCAL_BASE_URL instead of the main key.
LLM_MODELS=""
OPENAI_LOCAL_BASE_URL="http://localhost:11434/v1"

# System prompt injected at the top of every chat session.
CHAT_SYSTEM_PROMPT="You are the research partner for The Reluctant Capitalist. Answer honestly, push back on weak logic, and cite sources when you make factual claims."
